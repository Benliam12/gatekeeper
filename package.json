{
  "name": "@benliam12/gatekeeper",
  "version": "0.0.1",
  "description": "Universal permission system for Express and Elysia",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js",
      "require": "./dist/adapters/express.js"
    },
    "./elysia": {
      "types": "./dist/adapters/elysia.d.ts",
      "import": "./dist/adapters/elysia.js",
      "require": "./dist/adapters/elysia.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:express": "cd examples/express-app && npm install && npm start",
    "test:elysia": "cd examples/elysia-app && bun install && bun start",
    "dev:express": "cd examples/express-app && npm install && npm run dev",
    "dev:elysia": "cd examples/elysia-app && bun run dev",
    "setup:examples": "cd examples/express-app && npm install && cd ../elysia-app && bun install",
    "prepublishOnly": "bun run build && bun test",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "permissions",
    "rbac",
    "auth",
    "express",
    "elysia",
    "universal",
    "middleware"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Benliam12/gatekeeper.git"
  },
  "peerDependencies": {
    "express": "^4.18.0",
    "elysia": "^1.4.12"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "elysia": {
      "optional": true
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.29.5",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "elysia": "^1.4.12",
    "express": "^4.21.2",
    "mariadb": "^3.4.5",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}